{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
<div class="w-full">
    <form method="post">
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div class="mb-3">
                You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
            </div>
        {% endif %}


        <div class="flex flex-col w-fit mx-auto">

            <div class="text-lg lg:text-xl text-gray-700 font-semibold py-4 lg:py-6">
                <span><i>Please sign in</i></span>
            </div>

                <div class="text-md lg:text-lg text-gray-700 font-medium py-2">
                    <label for="username">Email</label>
                </div>

                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>

                <div class="text-md lg:text-lg text-gray-700 font-medium py-2">
                    <label for="password">Password</label>
                </div>

                <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <div class="flex justify-end">
                    <div class="py-4 w-fit">
                            <button class="justify-end border-2 border-gray-700 bg-gray-700 font-semibold lg:font-black text-md lg:text-lg text-white hover:text-gray-300 py-2 px-4 rounded-xl" type="submit">Sign in</button>
                    </div>
                </div>

        </div>
    </form>
</div>

{% endblock %}